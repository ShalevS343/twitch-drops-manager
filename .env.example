# --- Twitch -----------------------------------------------------------------
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Advanced: override the public Twitch client used for the read-only progress
# login and GQL calls. Leave blank to use the built-in first-party default.
TWITCH_DEVICE_CLIENT_ID=
TWITCH_DEVICE_CLIENT_SECRET=

# --- Telegram ---------------------------------------------------------------
# One bot for the whole deployment. Each user sets their own chat id and opts in
# from Settings → Telegram; there is no global recipient.
TELEGRAM_BOT_TOKEN=
# Used only to seed the migrating owner's chat id (and enable their alerts).
# It is not a fallback recipient for other users.
TELEGRAM_CHAT_ID=

# --- Catalog / polling ------------------------------------------------------
DROPS_API_KEY=
DEFAULT_GAMES=Rust,Minecraft
POLL_SECONDS=900
# How often to refresh personal drops progress (seconds, minimum 60).
PROGRESS_POLL_SECONDS=300
# How often the focused watcher re-checks the queue and moves to the next live
# stream (seconds, minimum 30). This never plays or simulates viewing.
WATCHER_POLL_SECONDS=60

# --- Multi-user auth --------------------------------------------------------
# Shared invite code for new accounts. Generate a long random value, e.g.:
#   openssl rand -base64 24
# Empty means registration is CLOSED once the first (admin) user exists. It
# never means "open". Rotate the value and redeploy to change the invite; clear
# it to close registration again.
REGISTRATION_CODE=
# Explicit escape hatch only: true allows new accounts without a code. Keep
# false on a public URL.
REGISTRATION_OPEN=false
# Numeric Twitch user id to bootstrap/claim the first admin when there is no
# legacy token, e.g. from https://www.twitch.tv/settings/connections or the
# Twitch API. Optional, but set it before removing basic auth if you care which
# account becomes admin. If empty and there is no owner, the first person to
# connect becomes admin.
OWNER_TWITCH_ID=
# Absolute session lifetime in days. Sessions do not slide; users sign in again
# when this expires.
SESSION_TTL_DAYS=30
# Session/CSRF cookie Secure flag:
#   auto  = Secure when the request arrives over HTTPS (X-Forwarded-Proto)
#   true  = always Secure (use for public HTTPS-only deployments)
#   false = never Secure (LAN HTTP development only)
SESSION_COOKIE_SECURE=auto
# Public origin for Origin/Host checks, e.g. https://pi.taile9ec1c.ts.net.
# Set this in production so cross-origin and same-origin fallbacks cannot be
# spoofed. Leave empty for local development.
PUBLIC_ORIGIN=
# Optional comma-separated Host allowlist, e.g. pi.taile9ec1c.ts.net,localhost.
# When set, requests with other Host headers are rejected. Prefer setting it in
# production alongside PUBLIC_ORIGIN.
ALLOWED_HOSTS=
# Registration/login attempts allowed per client IP per minute.
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- HTTP / CORS ------------------------------------------------------------
# Only needed for local Vite development; production is same-origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:8282

# --- Optional basic-auth rollout (staged) -----------------------------------
# The frontend nginx currently still requires HTTP basic auth. Point this at the
# host htpasswd file during the staged rollout, then remove it (and the nginx
# auth_basic lines) after app login is verified.
# DROPS_AUTH_FILE=/home/server/twitch-drops-auth/htpasswd
